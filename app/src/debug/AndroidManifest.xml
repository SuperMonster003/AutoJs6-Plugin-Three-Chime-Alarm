<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: the hook of .python/device_ring.py (roadmap P2.4). Protected by android.permission.DUMP, which only
    the shell and the system hold, so other apps cannot send it.
    zh-CN: 仅 debug 构建: .python/device_ring.py 的探针 (路线图 P2.4). 由 android.permission.DUMP 保护, 只有 shell 与系统持有, 其他应用无法发送.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".ring.RingDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
