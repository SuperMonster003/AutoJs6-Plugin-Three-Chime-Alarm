<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme of the plugin's Compose screens (roadmap P3, T22): no action bar, the neutral page background of the
        standalone settings specification (section 6); Compose draws everything else from ChimePalette.
    -->
    <style name="Theme.ThreeChimeAlarm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/chime_window_background</item>
        <item name="android:colorBackground">@color/chime_window_background</item>
    </style>

    <color name="chime_window_background">#F3F4F5</color>
</resources>
