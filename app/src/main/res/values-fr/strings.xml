    <string name="permissions_background_restricted">Restreint : le système bloque le service de sonnerie et les alarmes risquent de ne pas sonner</string>
    <string name="permissions_background_unrestricted">Sans restriction</string>
    <string name="permissions_battery">Optimisation de la batterie</string>
    <string name="permissions_battery_optimized">Optimisée : certains systèmes arrêtent le plugin en arrière-plan et les alarmes risquent de ne pas sonner. Il est conseillé de choisir sans restriction.</string>
    <string name="permissions_battery_unrestricted">Sans restriction</string>
